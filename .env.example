# Copy to .env (never commit it) or set these in your host's secret manager. All are read by the SERVER only.

# --- Server ---
PORT=3000
PUBLIC_URL=https://jobs.example.com   # used for cookie flags and links in emails; https => Secure cookies
DATA_DIR=./data                      # SQLite database + private résumé files. Must be on persistent storage.
ALLOW_SIGNUP=true                    # set to false after you create your account
TRUST_PROXY=false                    # true when behind a reverse proxy that sets X-Forwarded-For

# --- Job sources (https://developer.adzuna.com/ , https://developer.usajobs.gov/) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_DAILY_BUDGET=200              # stay under your plan's limits
USAJOBS_API_KEY=
USAJOBS_USER_EMAIL=                  # the email you registered with (sent as User-Agent)
USAJOBS_DAILY_BUDGET=200
# Employer career pages: list them in config/employer-feeds.json (see config/employer-feeds.example.json)
FEED_CONTACT_URL=                    # optional page describing who runs the bot; sent in the User-Agent

# --- Editorial photos (https://www.pexels.com/api/documentation/) ---
PEXELS_API_KEY=

# --- Email alerts (any SMTP provider) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Kother <jobs@example.com>"

# --- Web push (generate with: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Scheduler / pipeline (defaults shown) ---
SCHEDULER_ENABLED=true
SCAN_INTERVAL_HOURS=6
RESCAN_DEBOUNCE_MS=5000
MIN_REPEAT_SEARCH_MINUTES=360
MAX_QUERIES_PER_SCAN=24
STALE_AFTER_DAYS=14
VERIFIED_WITHIN_DAYS=3
